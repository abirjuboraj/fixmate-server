# Server Port (local only)
PORT=5000
NODE_ENV=production

# MongoDB Connection
MONGODB_URI=
DB_NAME=fixmate

# Frontend Client URL(s) for CORS (comma-separated, e.g. https://fixmate.vercel.app,http://localhost:3000)
CLIENT_ORIGIN=http://localhost:3000

# Stripe Credentials
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Payment Return URLs
CLIENT_SUCCESS_URL=http://localhost:3000/payment/success
CLIENT_CANCEL_URL=http://localhost:3000/payment/cancel
